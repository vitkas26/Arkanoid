<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="Widget.Ark.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minWidth">@dimen/end_button_min_width</item>
        <item name="android:minHeight">@dimen/end_button_min_height</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Ark.Button.Primary">
        <item name="android:background">@drawable/end_button_win</item>
        <item name="android:textColor">@color/end_button_text</item>
    </style>

    <style name="Widget.Ark.Button.Secondary">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/end_text_primary</item>
    </style>

    <style name="Widget.Ark.DialogTitle" parent="">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/win_gold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Ark.DialogText" parent="">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/end_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
