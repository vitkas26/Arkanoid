<?xml version="1.0" encoding="utf-8"?>
<com.example.arkanoidchristmas.MaxHeightScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_card"
        android:orientation="vertical"
        android:padding="@dimen/dialog_padding">

        <TextView
            style="@style/Widget.Ark.DialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/leaderboard_title" />

        <LinearLayout
            android:id="@+id/leaderboardRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/leaderboardClose"
            style="@style/Widget.Ark.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/close" />
    </LinearLayout>
</com.example.arkanoidchristmas.MaxHeightScrollView>
