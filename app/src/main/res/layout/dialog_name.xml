<?xml version="1.0" encoding="utf-8"?>
<com.example.arkanoidchristmas.MaxHeightScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_card"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <TextView
        style="@style/Widget.Ark.DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_dialog_title" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nameSummary"
                style="@style/Widget.Ark.DialogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/dialog_field"
                android:hint="@string/name_hint"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLength="16"
                android:minHeight="52dp"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="@color/end_text_primary"
                android:textColorHint="@color/end_text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

    <Button
        android:id="@+id/nameConfirm"
        style="@style/Widget.Ark.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/save_confirm" />

    <Button
        android:id="@+id/nameCancel"
        style="@style/Widget.Ark.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cancel" />
</LinearLayout>
</com.example.arkanoidchristmas.MaxHeightScrollView>
